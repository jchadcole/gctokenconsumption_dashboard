# Genesys Cloud OAuth client (Client Credentials grant). Never commit real values.
# To keep them in 1Password instead, use .env.tpl and `npm run start:op`, or put
# op://<vault>/<item>/<field> references here and start with: op run --env-file=.env -- npm start
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
# Region host suffix, e.g. mypurecloud.com (US East), usw2.pure.cloud, use2.us-gov-pure.cloud, mypurecloud.ie, euw2.pure.cloud
GENESYS_REGION=mypurecloud.com

# Set to 1 to run with generated sample data (no Genesys credentials needed)
GENESYS_MOCK=0

PORT=3000
# Time zone used for daily buckets (IANA name, e.g. America/Chicago). Default: this machine's time zone
# REPORT_TIMEZONE=America/Chicago
# Max days per analytics aggregate query; longer ranges are split into chunks
ANALYTICS_MAX_DAYS=31
# Minutes to cache the flow / AVA catalog
CATALOG_CACHE_MINUTES=15

# Token rules. Override if your contract differs.
#  1. Voice bots: each call billed in RATE_VOICE_BOT_INCREMENT_SECONDS increments (rounded up); total rounded up to a whole minute, then divided by this
RATE_VOICE_BOT_MINUTES_PER_TOKEN=17
RATE_VOICE_BOT_INCREMENT_SECONDS=15
#  2. Digital bots: prompt/response turns per token
RATE_DIGITAL_BOT_TURNS_PER_TOKEN=51
#  3. Virtual Agents: sessions per token
RATE_VIRTUAL_AGENT_SESSIONS_PER_TOKEN=2
#  4. Agentic Virtual Agents: tokens per session
RATE_AVA_TOKENS_PER_SESSION=1.2
#  5. Each conversation consumes tokens only for the highest tier it reached (AVA > Virtual Agent > Bot). Always on.
#  6. Consumption is rounded up to whole tokens for the date range: type (each bot's unrounded tokens
#     are added up and only the Bot, VA and AVA totals are rounded up; the org total is the sum of the
#     three; default), flow (each bot / flow on its own), product (voice bot, digital bot, VA, AVA
#     each), total (all types together) or none.
TOKEN_ROUNDING=type

# Optional: also call the undocumented /api/v2/billing/subscriptionoverview endpoint the Admin UI uses (unsupported)
ENABLE_INTERNAL_SUBSCRIPTION_OVERVIEW=0
