{
  "name": "genesys-token-dashboard",
  "version": "1.0.0",
  "description": "Genesys Cloud AI token consumption dashboard: Bots, Virtual Agents and Agentic Virtual Agents",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "mock": "GENESYS_MOCK=1 node src/server.js",
    "test": "node --test test/*.test.js",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\"",
    "version": "node scripts/changelog-release.js && git add CHANGELOG.md",
    "postversion": "git push --follow-tags"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jchadcole/gctokenconsumption_dashboard.git"
  }
}
